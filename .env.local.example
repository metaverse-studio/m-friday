# Lấy khóa miễn phí tại https://console.groq.com/keys
# Hỗ trợ 1 key hoặc nhiều key xoay tua ngẫu nhiên (phân tách bằng dấu phẩy)
GROQ_API_KEY=gsk_thay_bang_key_cua_ban
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# VieNeu API Key: hỗ trợ 1 key hoặc nhiều key xoay tua ngẫu nhiên (phân tách bằng dấu phẩy)
VIENEU_API_KEY=vn_sk_thay_bang_key_cua_ban
# VIENEU_API_KEYS=vn_sk_key1,vn_sk_key2

# Lựa chọn TTS Provider: 'edge-tts' hoặc 'vieneu' (khi restart server)
TTS_PROVIDER=vieneu
# Tùy chọn giọng đọc VieNeu (mặc định: 'Ngọc Lan' - có thể đổi 'Mai Anh', 'Phương Liên',...)
VIENEU_VOICE=Ngọc Lan
